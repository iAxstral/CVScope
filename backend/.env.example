# Configuración del LLM — Gemini vía endpoint compatible con OpenAI
OPENAI_API_KEY=tu_api_key_de_google_ai_studio
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Base de datos (ajustar según motor elegido)
DATABASE_URL=postgresql://usuario:password@localhost:5432/preseleccion_talento
