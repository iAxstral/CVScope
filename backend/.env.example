# Configuración del LLM — Gemini vía endpoint compatible con OpenAI
OPENAI_API_KEY=tu_api_key_de_google_ai_studio
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Base de datos. Si se omite, se usa SQLite en backend/cvscope.db.
# Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/cvscope

# Autenticación. AUTH_SECRET y ADMIN_PASSWORD son OBLIGATORIAS: sin ellas la API
# no arranca (no hay valores por defecto).
# AUTH_SECRET firma las sesiones: usa un valor largo y aleatorio
# (python -c "import secrets; print(secrets.token_hex(32))").
AUTH_SECRET=
# Administrador inicial: se crea la primera vez que arranca la API
ADMIN_EMAIL=admin@cvscope.co
ADMIN_PASSWORD=

# Límite de intentos de login fallidos por IP y correo (opcional)
# LOGIN_MAX_INTENTOS=5
# LOGIN_VENTANA_SEGUNDOS=900
