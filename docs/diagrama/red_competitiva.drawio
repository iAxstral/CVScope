<mxfile host="CVScope" type="device"><diagram id="red-competitiva" name="Red neuronal competitiva"><mxGraphModel dx="1720" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" background="#f1f4f8" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="&lt;b&gt;CVScope · Red neuronal competitiva (tipo Hamming)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=23;absoluteArcSize=0;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="18.0" width="1660.0" height="34.0" as="geometry"/></mxCell><mxCell id="subtitulo" value="Cada hoja de vida es una neurona. Una capa de evaluación entrenada calcula su fuerza y una capa competitiva (MAXNET) las enfrenta por inhibición lateral hasta que solo una queda activa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=13;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=30;absoluteArcSize=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30.0" y="54.0" width="1660.0" height="26.0" as="geometry"/></mxCell><mxCell id="col_entrada" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=6;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="100.0" width="230.0" height="690.0" as="geometry"/></mxCell><mxCell id="col_entrada_t" value="&lt;b&gt;1 · DATOS DE ENTRADA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=36;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="100.0" width="230.0" height="38.0" as="geometry"/></mxCell><mxCell id="col_pre" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=5;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="275.0" y="100.0" width="270.0" height="690.0" as="geometry"/></mxCell><mxCell id="col_pre_t" value="&lt;b&gt;2 · PREPROCESAMIENTO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=36;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275.0" y="100.0" width="270.0" height="38.0" as="geometry"/></mxCell><mxCell id="col_eval" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=3;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="560.0" y="100.0" width="450.0" height="690.0" as="geometry"/></mxCell><mxCell id="col_eval_t" value="&lt;b&gt;3 · CAPA DE EVALUACIÓN (feedforward, entrenada)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=36;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560.0" y="100.0" width="450.0" height="38.0" as="geometry"/></mxCell><mxCell id="col_comp" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=3;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1025.0" y="100.0" width="405.0" height="690.0" as="geometry"/></mxCell><mxCell id="col_comp_t" value="&lt;b&gt;4 · CAPA COMPETITIVA MAXNET (recurrente)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=36;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1025.0" y="100.0" width="405.0" height="38.0" as="geometry"/></mxCell><mxCell id="col_salida" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=5;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1445.0" y="100.0" width="245.0" height="690.0" as="geometry"/></mxCell><mxCell id="col_salida_t" value="&lt;b&gt;5 · SALIDA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=36;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1445.0" y="100.0" width="245.0" height="38.0" as="geometry"/></mxCell><mxCell id="cv0" value="&lt;b&gt;Hoja de vida 1&lt;/b&gt;&lt;br&gt;PDF · DOCX · TXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=13;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="55.0" y="160.0" width="180.0" height="58.0" as="geometry"/></mxCell><mxCell id="cv1" value="&lt;b&gt;Hoja de vida 2&lt;/b&gt;&lt;br&gt;PDF · DOCX · TXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=13;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="55.0" y="235.0" width="180.0" height="58.0" as="geometry"/></mxCell><mxCell id="cv2" value="&lt;b&gt;Hoja de vida n&lt;/b&gt;&lt;br&gt;PDF · DOCX · TXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=13;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="55.0" y="345.0" width="180.0" height="58.0" as="geometry"/></mxCell><mxCell id="cv_puntos" value="⋮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=20;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="55.0" y="298.0" width="180.0" height="40.0" as="geometry"/></mxCell><mxCell id="requisitos" value="&lt;b&gt;Requisitos del rol&lt;/b&gt;&lt;br&gt;ej. Full Stack:&lt;br&gt;• JavaScript/TypeScript&lt;br&gt;• React o similar&lt;br&gt;• Node.js o backend&lt;br&gt;• Bases de datos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0da;strokeColor=#e8a63d;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=5;absoluteArcSize=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="55.0" y="440.0" width="180.0" height="150.0" as="geometry"/></mxCell><mxCell id="entrada_nota" value="Entran todas las hojas de vida que compiten por el mismo rol (n = 15 en el dataset de ranking) y los requisitos mínimos de ese rol." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=5;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="610.0" width="200.0" height="150.0" as="geometry"/></mxCell><mxCell id="anonimizar" value="&lt;b&gt;Anonimización&lt;/b&gt;&lt;br&gt;quita nombre, ciudad, edad,&lt;br&gt;género, correo y teléfono" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="295.0" y="160.0" width="230.0" height="96.0" as="geometry"/></mxCell><mxCell id="extraer" value="&lt;b&gt;Extracción de características&lt;/b&gt;&lt;br&gt;vector x por hoja de vida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="295.0" y="300.0" width="230.0" height="80.0" as="geometry"/></mxCell><mxCell id="vector_t" value="&lt;b&gt;x ∈ ℝ¹⁰²⁶&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=36;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="295.0" y="400.0" width="230.0" height="22.0" as="geometry"/></mxCell><mxCell id="x1" value="x₁ = fracción de requisitos&lt;br&gt;cumplidos (0 a 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="305.0" y="428.0" width="210.0" height="48.0" as="geometry"/></mxCell><mxCell id="x2" value="x₂ = años de experiencia / 12&lt;br&gt;(tope 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="305.0" y="476.0" width="210.0" height="48.0" as="geometry"/></mxCell><mxCell id="x3" value="x₃ … x₁₀₂₆ = 1024 n-gramas&lt;br&gt;(palabras y pares de palabras,&lt;br&gt;hashing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=6;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="305.0" y="524.0" width="210.0" height="62.0" as="geometry"/></mxCell><mxCell id="pre_nota" value="La red nunca ve datos personales: así no puede aprender sesgos por nombre, ciudad o género. Los n-gramas le permiten reconocer requisitos escritos sin palabras clave." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=5;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="290.0" y="600.0" width="240.0" height="150.0" as="geometry"/></mxCell><mxCell id="n0_0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606.0" y="161.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n0_1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606.0" y="206.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n0_2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606.0" y="251.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n0_3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="606.0" y="331.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n0_p" value="⋮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=33;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="600.0" y="293.0" width="40.0" height="24.0" as="geometry"/></mxCell><mxCell id="n0_t" value="&lt;b&gt;Entrada&lt;/b&gt;&lt;br&gt;1026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=22;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="570.0" y="372.0" width="100.0" height="36.0" as="geometry"/></mxCell><mxCell id="n1_0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="721.0" y="176.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n1_1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="721.0" y="221.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n1_2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="721.0" y="266.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n1_3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="721.0" y="326.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n1_p" value="⋮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=33;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="715.0" y="298.0" width="40.0" height="24.0" as="geometry"/></mxCell><mxCell id="n1_t" value="&lt;b&gt;Oculta 1&lt;/b&gt;&lt;br&gt;64 · ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=22;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="685.0" y="372.0" width="100.0" height="36.0" as="geometry"/></mxCell><mxCell id="n2_0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836.0" y="191.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n2_1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836.0" y="236.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n2_2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e7ebf5;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836.0" y="306.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="n2_p" value="⋮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5c6b8a;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=33;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="830.0" y="273.0" width="40.0" height="24.0" as="geometry"/></mxCell><mxCell id="n2_t" value="&lt;b&gt;Oculta 2&lt;/b&gt;&lt;br&gt;32 · ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=22;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="800.0" y="372.0" width="100.0" height="36.0" as="geometry"/></mxCell><mxCell id="salida_s" value="s(x)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="937.0" y="239.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="salida_s_t" value="&lt;b&gt;Salida&lt;/b&gt;&lt;br&gt;fuerza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=22;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="915.0" y="372.0" width="90.0" height="36.0" as="geometry"/></mxCell><mxCell id="siamesa" value="&lt;b&gt;Misma red y mismos pesos para todas las hojas de vida (red siamesa)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=14;absoluteArcSize=0;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585.0" y="425.0" width="330.0" height="54.0" as="geometry"/></mxCell><mxCell id="fuerzas" value="&lt;b&gt;Una fuerza por hoja de vida&lt;/b&gt;&lt;br&gt;Hoja de vida 1  →  s₁ = 23.4&lt;br&gt;Hoja de vida 2  →  s₂ = 23.2&lt;br&gt;Hoja de vida n  →  sₙ = 9.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=6;absoluteArcSize=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="585.0" y="500.0" width="400.0" height="118.0" as="geometry"/></mxCell><mxCell id="activacion" value="&lt;b&gt;Activación inicial de cada neurona competitiva&lt;/b&gt;&lt;br&gt;aᵢ(0) = exp(sᵢ − max s)   ∈ (0, 1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0da;strokeColor=#e8a63d;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=11;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="585.0" y="640.0" width="400.0" height="70.0" as="geometry"/></mxCell><mxCell id="c1" value="HV 1&lt;br&gt;a₁" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1084.0" y="189.0" width="72.0" height="72.0" as="geometry"/></mxCell><mxCell id="c2" value="HV 2&lt;br&gt;a₂" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1294.0" y="189.0" width="72.0" height="72.0" as="geometry"/></mxCell><mxCell id="cn" value="HV n&lt;br&gt;aₙ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1189.0" y="349.0" width="72.0" height="72.0" as="geometry"/></mxCell><mxCell id="eps1" value="&lt;b&gt;−ε&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d64550;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=40;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1195.0" y="196.0" width="60.0" height="20.0" as="geometry"/></mxCell><mxCell id="eps2" value="&lt;b&gt;−ε&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d64550;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=40;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100.0" y="296.0" width="50.0" height="20.0" as="geometry"/></mxCell><mxCell id="eps3" value="&lt;b&gt;−ε&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#d64550;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=40;absoluteArcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="296.0" width="50.0" height="20.0" as="geometry"/></mxCell><mxCell id="regla" value="&lt;b&gt;Regla de competencia (cada iteración t)&lt;/b&gt;&lt;br&gt;aᵢ(t+1) = max(0, aᵢ(t) − ε · Σⱼ≠ᵢ aⱼ(t))&lt;br&gt;con 0 &amp;lt; ε &amp;lt; 1/(S − 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=8;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1045.0" y="470.0" width="365.0" height="92.0" as="geometry"/></mxCell><mxCell id="wta" value="&lt;b&gt;Se repite hasta que solo una neurona queda activa&lt;/b&gt;&lt;br&gt;(winner-take-all)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f6ee;strokeColor=#2f9e64;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=17;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1045.0" y="575.0" width="365.0" height="46.0" as="geometry"/></mxCell><mxCell id="ejemplo" value="&lt;b&gt;Ejemplo: duelo de 2 neuronas (ε = 0.5)&lt;/b&gt;&lt;br&gt;t = 0:   A = 1.00   B = 0.82&lt;br&gt;t = 1:   A = 0.59   B = 0.32&lt;br&gt;t = 2:   A = 0.43   B = 0.02&lt;br&gt;t = 3:   A = 0.42   B = 0.00&lt;br&gt;→ gana A (P = 55.0 %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe4ee;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;arcSize=8;absoluteArcSize=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1045.0" y="634.0" width="365.0" height="98.0" as="geometry"/></mxCell><mxCell id="onehot" value="&lt;b&gt;Salida one-hot&lt;/b&gt;&lt;br&gt;[0, 1, 0, …, 0]&lt;br&gt;solo la ganadora en 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17244d;strokeColor=#17244d;fontColor=#ffffff;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=10;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1470.0" y="160.0" width="195.0" height="80.0" as="geometry"/></mxCell><mxCell id="ganadora" value="&lt;b&gt;Hoja de vida ganadora&lt;/b&gt;&lt;br&gt;(campeona del rol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8a63d;strokeColor=#e8a63d;fontColor=#17244d;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1470.0" y="268.0" width="195.0" height="62.0" as="geometry"/></mxCell><mxCell id="probs" value="&lt;b&gt;Probabilidad de ganar&lt;/b&gt;&lt;br&gt;Pᵢ = softmax(s)ᵢ&lt;br&gt;duelo: σ(s_A − s_B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1470.0" y="352.0" width="195.0" height="66.0" as="geometry"/></mxCell><mxCell id="top5" value="&lt;b&gt;Top 5&lt;/b&gt;&lt;br&gt;se retira la ganadora&lt;br&gt;y se repite la competencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=12;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1470.0" y="440.0" width="195.0" height="66.0" as="geometry"/></mxCell><mxCell id="torneo" value="&lt;b&gt;Torneo&lt;/b&gt;&lt;br&gt;duelos de 2 neuronas;&lt;br&gt;la ganadora pasa&lt;br&gt;a la siguiente ronda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=9;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1470.0" y="528.0" width="195.0" height="82.0" as="geometry"/></mxCell><mxCell id="explicacion" value="&lt;b&gt;Explicación&lt;/b&gt;&lt;br&gt;requisitos con evidencia&lt;br&gt;e iteraciones de&lt;br&gt;inhibición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22346b;fontColor=#17203a;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=9;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1470.0" y="632.0" width="195.0" height="82.0" as="geometry"/></mxCell><mxCell id="regla_ancla" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#17203a;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;arcSize=40;absoluteArcSize=0;" vertex="1" parent="1"><mxGeometry x="1044.0" y="515.0" width="2.0" height="2.0" as="geometry"/></mxCell><mxCell id="fuerzas_ancla" value="" style="rounded=1;whiteS